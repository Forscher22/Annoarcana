---
permalink: /comic-index.json
eleventyExcludeFromCollections: true
---
{%- comment -%}
A list of every published comic page, used by the /admin/ dashboard to
suggest the next page number and show what's already on the site.
{%- endcomment -%}
[
{%- for item in collections.comic %}
  {%- assign chapter = item.data.tags | where_exp: "tag", "tag contains 'chapter'" | first | remove_first: "chapter" %}
  {
    "number": {{ item.data.pageNumber | default: item.page.fileSlug | plus: 0 }},
    "url": {{ item.url | json }},
    "title": {{ item.data.title | json }},
    "chapter": {{ chapter | default: 1 | plus: 0 }},
    "date": {{ item.date | date: "%Y-%m-%d" | json }},
    "image": {{ item.data.images[0] | thumbImage | json }},
    "source": {% if item.data.dashboardId %}"dashboard", "id": {{ item.data.dashboardId }}{% else %}"file"{% endif %}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
