---
permalink: /admin/
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Studio | {{ metadata.title }}</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <script type="module" src="/admin/admin.js"></script>
  </head>
  <body class="studio">
    <header class="studio-header">
      <a href="/" class="studio-banner"><img src="/img/banner.png" alt="Back to the comic"></a>
      <div class="studio-heading">
        <p class="studio-kicker">Behind the curtain</p>
        <h1>The Studio</h1>
      </div>
      <div class="studio-session" hidden>
        <span class="studio-user"></span>
        <button type="button" class="link-button" data-action="logout">Log out</button>
      </div>
    </header>

    <main class="studio-main">
      <p class="studio-loading" data-view="loading">Opening the studio&hellip;</p>

      <!-- Log in -->
      <section class="paperDiv studio-card studio-narrow" data-view="login" hidden>
        <h2>Log in</h2>
        <p>Only the comic's admins can post pages here.</p>
        <form data-form="login">
          <label>Email <input type="email" name="email" autocomplete="username" required></label>
          <label>Password <input type="password" name="password" autocomplete="current-password" required></label>
          <p class="form-error" role="alert"></p>
          <button type="submit" class="ink-button">Log in</button>
          <button type="button" class="link-button" data-action="forgot">Forgot your password?</button>
        </form>
        <p class="studio-switch">First time here? <button type="button" class="link-button" data-action="show-signup">Create your account</button></p>
      </section>

      <!-- Create an account (only admin emails are accepted) -->
      <section class="paperDiv studio-card studio-narrow" data-view="signup" hidden>
        <h2>Create your account</h2>
        <p>Use the email address that's been set up as the comic's admin. We'll email you a link to confirm it.</p>
        <form data-form="signup">
          <label>Email <input type="email" name="email" autocomplete="username" required></label>
          <label>Password <input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
          <p class="form-error" role="alert"></p>
          <button type="submit" class="ink-button">Create account</button>
        </form>
        <p class="studio-switch">Already have an account? <button type="button" class="link-button" data-action="show-login">Log in</button></p>
      </section>

      <!-- Waiting on the confirmation email -->
      <section class="paperDiv studio-card studio-narrow" data-view="check-email" hidden>
        <h2>Check your email</h2>
        <p>We sent a confirmation link to <strong data-slot="signup-email"></strong>. Click it and you'll come straight back here, logged in.</p>
      </section>

      <!-- Set a password after an invite or a reset email -->
      <section class="paperDiv studio-card studio-narrow" data-view="set-password" hidden>
        <h2 data-slot="password-heading">Choose a password</h2>
        <form data-form="set-password">
          <label>New password <input type="password" name="password" autocomplete="new-password" minlength="8" required></label>
          <p class="form-error" role="alert"></p>
          <button type="submit" class="ink-button">Save password</button>
        </form>
      </section>

      <!-- Logged in without the admin role -->
      <section class="paperDiv studio-card studio-narrow" data-view="no-role" hidden>
        <h2>Almost there</h2>
        <p>You're logged in, but your account doesn't have the <strong>admin</strong> role yet.
          In the Netlify dashboard, open <strong>Identity</strong>, click your account, add the role
          <code>admin</code>, then log out and back in here.</p>
      </section>

      <!-- Dashboard -->
      <div class="studio-desk" data-view="dashboard" hidden>
        <section class="paperDiv studio-card studio-upload">
          <h2>Post a new page</h2>
          <form data-form="upload">
            <label class="drop-zone">
              <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" required>
              <img class="drop-preview" alt="" hidden>
              <span class="drop-hint"><strong>Choose the page image</strong><br>PNG, JPG, WebP or GIF</span>
            </label>

            <div class="field-row">
              <label>Page number <input type="number" name="pageNumber" min="1" required></label>
              <label>Chapter
                <select name="chapter" required>
                  {%- for ch in chapterNames %}
                  <option value="{{ ch.number }}"{% if ch.number == 1 %} selected{% endif %}>{{ ch.name }}</option>
                  {%- endfor %}
                </select>
              </label>
              <label>Posting date <span class="optional">pick a future date to schedule it</span>
                <input type="date" name="postedOn" required></label>
            </div>

            <label>Title <span class="optional">optional; leave blank to show "Page 12"</span>
              <input type="text" name="title" maxlength="200">
            </label>
            <label>Image description <span class="optional">read aloud by screen readers</span>
              <textarea name="alt" rows="3" placeholder="Describe what happens on the page, including any narration or dialogue."></textarea>
            </label>
            <label>Author notes <span class="optional">optional; Markdown works</span>
              <textarea name="notes" rows="4"></textarea>
            </label>
            <label class="check"><input type="checkbox" name="spread"> This is a two-page spread (shows a little wider)</label>

            <p class="form-error" role="alert"></p>
            <button type="submit" class="ink-button">Post page</button>
            <button type="button" class="link-button" data-action="cancel-edit" hidden>Cancel editing</button>
          </form>
        </section>

        <section class="studio-pages">
          <div class="pages-head">
            <h2>Pages</h2>
            <button type="button" class="ink-button ink-button-ghost" data-action="publish">Publish now</button>
          </div>
          <p class="studio-notice" data-slot="notice" hidden></p>
          <ol class="page-list" data-slot="pages"></ol>

          <div class="pages-head comments-head">
            <h2>Recent comments</h2>
          </div>
          <ol class="studio-comments" data-slot="comments"></ol>
        </section>

        <section class="paperDiv studio-card studio-news">
          <h2 data-slot="news-heading">Write a news post</h2>
          <form data-form="news">
            <div class="field-row">
              <label>Title <input type="text" name="title" maxlength="200" required></label>
              <label>Date <input type="date" name="postedOn" required></label>
            </div>
            <label>Post <span class="optional">Markdown works</span>
              <textarea name="body" rows="6"></textarea>
            </label>
            <p class="form-error" role="alert"></p>
            <button type="submit" class="ink-button">Post news</button>
            <button type="button" class="link-button" data-action="cancel-news-edit" hidden>Cancel editing</button>
          </form>

          <div class="pages-head">
            <h2>News posts</h2>
            <a href="/news/">View news page</a>
          </div>
          <ol class="page-list" data-slot="news"></ol>
        </section>

        <section class="paperDiv studio-card studio-news">
          <h2>Edit site pages</h2>
          <form data-form="section">
            <label>Page
              <select name="slug">
                <option value="about">About</option>
                <option value="characters">Characters (intro text above the list)</option>
                <option value="support">Support</option>
                <option value="links">Links</option>
              </select>
            </label>
            <label>Text <span class="optional">Markdown works: **bold**, *italics*, [link text](https://…), ## headings, - lists</span>
              <textarea name="body" rows="10"></textarea>
            </label>
            <p class="form-error" role="alert"></p>
            <button type="submit" class="ink-button">Save page</button>
          </form>
        </section>

        <section class="paperDiv studio-card studio-news">
          <h2 data-slot="character-heading">Add a character</h2>
          <form data-form="character">
            <label class="drop-zone">
              <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
              <img class="drop-preview" alt="" hidden>
              <span class="drop-hint"><strong>Choose a picture</strong><br>optional; PNG, JPG, WebP or GIF</span>
            </label>
            <div class="field-row">
              <label>Name <input type="text" name="name" maxlength="200" required></label>
              <label>Order <span class="optional">lower shows first</span> <input type="number" name="position" value="0" required></label>
            </div>
            <label>Description <span class="optional">Markdown works</span>
              <textarea name="description" rows="4"></textarea>
            </label>
            <label class="check" data-slot="remove-image" hidden><input type="checkbox" name="removeImage"> Remove the current picture</label>
            <p class="form-error" role="alert"></p>
            <button type="submit" class="ink-button">Add character</button>
            <button type="button" class="link-button" data-action="cancel-character-edit" hidden>Cancel editing</button>
          </form>

          <div class="pages-head">
            <h2>Characters</h2>
            <a href="/characters/">View characters page</a>
          </div>
          <ol class="page-list" data-slot="characters"></ol>
        </section>

        <section class="paperDiv studio-card studio-news">
          <h2>Backups</h2>
          <p>
            Comments, news posts, characters, notes and page text live in the site's database.
            A backup is saved automatically every week (the last 12 are kept), and you can grab
            an up-to-date copy here any time. Keep one somewhere safe now and then.
          </p>
          <a class="ink-button" href="/api/backup" download>Download a backup</a>
        </section>
      </div>

      <!-- Author notes editor -->
      <dialog class="notes-dialog" data-slot="notes-dialog">
        <form data-form="notes" method="dialog">
          <h2 data-slot="notes-heading">Author notes</h2>
          <label>Notes <span class="optional">shown under the page; Markdown works. Leave blank for no notes.</span>
            <textarea name="notes" rows="9"></textarea>
          </label>
          <p class="form-error" role="alert"></p>
          <div class="dialog-actions">
            <button type="submit" class="ink-button" value="save">Save notes</button>
            <button type="button" class="link-button" data-action="close-notes">Cancel</button>
          </div>
        </form>
      </dialog>
    </main>
  </body>
</html>
