<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- comment %}
    Comic pages describe themselves with their alt text and name their chapter
    in the title. Other pages can set a `description` in their front matter,
    and anything else falls back to the site-wide description.
    {% endcomment %}
    {%- assign chapterName = "" %}
    {%- for tag in tags %}
      {%- assign prefix = tag | slice: 0, 7 %}
      {%- if prefix == "chapter" %}
        {%- assign chapterNumber = tag | remove_first: "chapter" | plus: 0 %}
        {%- for ch in chapterNames %}
          {%- if ch.number == chapterNumber %}{% assign chapterName = ch.name %}{% endif %}
        {%- endfor %}
      {%- endif %}
    {%- endfor %}
    {%- if alt %}
      {%- assign pageDescription = alt | normalize_whitespace | truncate: 160 %}
    {%- elsif description %}
      {%- assign pageDescription = description %}
    {%- else %}
      {%- assign pageDescription = metadata.description %}
    {%- endif %}
    <meta name="description" content="{{ pageDescription | escape }}">
    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- else %}
    <link rel="canonical" href="{{ metadata.base }}{{ page.url }}">
    {%- endif %}
    <link rel="alternate" type="application/rss+xml" title="{{ metadata.title | escape }}: every new page" href="/feed.xml">
    <link rel="alternate" type="application/rss+xml" title="{{ metadata.title | escape }}: new chapters" href="/chapters.xml">
    {%- comment %}
    Link previews for sites like Discord, Bluesky and X. Comic pages show
    their first image; every other page shows the banner.
    {% endcomment %}
    {%- capture pageTitle %}{% if title %}{{ title }}{% if chapterName != "" %} – {{ chapterName }}{% endif %} | {% endif %}{{ metadata.title }}{% endcapture %}
    {%- if images and images.size > 0 %}
      {%- assign share = images | first | shareImage %}
      {%- assign shareAlt = alt | default: metadata.title %}
    {%- else %}
      {%- assign share = "/img/banner.png" | shareImage %}
      {%- assign shareAlt = metadata.title %}
    {%- endif %}
    <meta property="og:site_name" content="{{ metadata.title | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ pageTitle | escape }}">
    <meta property="og:description" content="{{ pageDescription | escape }}">
    <meta property="og:url" content="{{ metadata.base }}{{ page.url }}">
    <meta property="og:image" content="{{ metadata.base }}{{ share.url }}">
    {%- if share.width %}
    <meta property="og:image:width" content="{{ share.width }}">
    <meta property="og:image:height" content="{{ share.height }}">
    {%- endif %}
    <meta property="og:image:alt" content="{{ shareAlt | normalize_whitespace | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@forscher22">
    <script>
      // Invite and password-reset emails link to the home page; send those
      // links on to the admin dashboard, which knows how to handle them.
      if (/(invite|recovery|confirmation)_token=/.test(location.hash)) {
        location.replace("/admin/" + location.hash);
      }
    </script>
    <!--
    For data that affects the whole site (say, metadata that describes it), we
    can add global data to 11ty's data folder! Feel free to expand the included
    `metadata.json` file with any other information you deem necessary!
    (https://www.11ty.dev/docs/data-global/)
    -->
    <title>{{ pageTitle }}</title>
    {%- comment %}
    Google AdSense site code (publisher ID in `adsenseClient` in
    _data/metadata.json; leave it empty to turn AdSense off). The matching
    ads.txt is in the site root.
    {% endcomment %}
    {%- if metadata.adsenseClient != "" %}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ metadata.adsenseClient }}" crossorigin="anonymous"></script>
    {%- endif %}
    <link rel="icon" 
      type="image/png" 
      href="/img/favicon.png?v=2">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <link href="/css/style.css"
      rel="stylesheet"
      type="text/css"
      media="all" />
    <!-- Fonts are sourced from Google Fonts (https://fonts.google.com/) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
    </head>
  <body>
    {%# We use `render` tags to include other liquid files in our template %}
    {% render 'header.liquid', adInBookmarkRow: adInBookmarkRow %}
    {% comment %}
    Since this file is used as a layout, we use the `content` variable to mark
    where the contents of pages that use this layout go!
    (https://www.11ty.dev/docs/layouts/)
    {% endcomment %}
    <main>

      {{ content }}
    </main>
    {% render 'footer.liquid' %}
    {%- comment %}
    Visitor stats (GoatCounter: no cookies, no personal data). Turned on by
    putting the site code from goatcounter.com in `goatcounter` in
    _data/metadata.json, e.g. "annoarcana" for annoarcana.goatcounter.com.
    The Studio isn't counted.
    {% endcomment %}
    {%- if metadata.goatcounter != "" %}{% unless page.url contains "/admin/" %}
    <script data-goatcounter="https://{{ metadata.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    {%- endunless %}{% endif %}
  </body>
</html>