{% comment %}
The author notes box under each comic page. Notes written in the Studio
(stored in `pageNotes`) take priority over notes written in the page's file.
{% endcomment %}
{%- assign studioNotes = pageNotes[number] -%}
<div class="authorNotes paperDiv">
  <h1>{{ title }}</h1>
  <p class="authorNotes-date">posted on {{ date | utcDate }}</p>
  {%- if studioNotes %}
    {{ studioNotes | markdown }}
  {%- elsif content != "" %}
    {{ content }}
  {%- endif %}
  <p class="authorNotes-discord">
    <a href="https://discord.gg/7VmVTeFrwu" target="_blank" rel="noopener">
      <svg viewBox="0 0 127.14 96.36" width="24" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"/></svg>
      Join the Anno Arcana discord!
    </a>
  </p>
  {%- if url %}
  {%- comment %} Share links; the Copy button is handled by js/share.js {% endcomment %}
  {%- assign shareUrl = base | append: url %}
  {%- assign shareText = title | append: " – Anno Arcana" %}
  <div class="share-row">
    <span class="share-label">Share this page:</span>
    <button type="button" class="share-copy" data-share-url="{{ shareUrl }}" data-share-title="{{ shareText | escape }}">Copy link</button>
    <a href="https://bsky.app/intent/compose?text={{ shareText | append: ' ' | append: shareUrl | url_encode }}" target="_blank" rel="noopener">Bluesky</a>
    <a href="https://x.com/intent/tweet?text={{ shareText | url_encode }}&amp;url={{ shareUrl | url_encode }}" target="_blank" rel="noopener">X</a>
  </div>
  {%- endif %}
  {%- if chapterNumber != nil and chapterNumber != "" %}
  <p class="chapter-read-link"><a href="/chapter/{{ chapterNumber }}/">Read {{ chapterTitle | default: "this chapter" }} on one page &rarr;</a></p>
  {%- endif %}
  <span class="fox-mark fox-tail authorNotes-tail" aria-hidden="true"></span>
</div>
