{% comment %}
Reader comments for a comic page. They're loaded and posted by
/js/comments.js, so new comments show up without rebuilding the site.
{% endcomment %}
<section class="paperDiv comments-wrapper" data-comments data-page="{{ number }}" aria-labelledby="comments-heading">
  <h2 id="comments-heading">Comments <span class="comments-count" data-comments-count></span></h2>

  <ol class="comments-list" data-comments-list>
    <li class="comments-status">Loading comments&hellip;</li>
  </ol>

  <form class="comments-form" data-comments-form>
    <h3>Leave a comment</h3>
    <label>Name <input type="text" name="name" maxlength="60" autocomplete="nickname" required></label>
    <label>Comment <textarea name="body" rows="4" maxlength="2000" required></textarea></label>
    {%- comment %} Hidden from people; bots that fill it in are ignored {% endcomment %}
    <label class="comments-trap" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    <p class="comments-error" role="alert" data-comments-error></p>
    <button type="submit">Post comment</button>
  </form>
</section>
<script src="/js/comments.js" defer></script>
