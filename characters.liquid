---
title: Characters
layout: layouts/page.liquid
---
{% comment %}
Characters and the intro text above them are edited in the Studio (/admin/)
and stored in Netlify Database. They're pulled in at build time as the
`characters` and `sections` global data (see eleventy.config.js).
{% endcomment %}
{{ sections.characters | markdown }}
<div class="characters">
{%- if characters == null %}
  <p>The character list couldn't be loaded right now.</p>
{%- endif %}
{%- for character in characters %}
  <div class="character">
    {%- if character.image != "" %}
    <img src="{{ character.image }}" alt="{{ character.name | escape }}" class="clearfix rightPic" loading="lazy" eleventy:ignore />
    {%- else %}
    <div></div>
    {%- endif %}
    <div>
      <h2>{{ character.name | escape }}</h2>
      {{ character.description | markdown }}
    </div>
  </div>
{%- endfor %}
</div>
